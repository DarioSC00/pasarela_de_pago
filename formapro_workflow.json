      "parameters": {
        "jsCode": "// ============================================================\n// NORMALIZACIÓN DE DATOS\n// Maneja: espacios, mayúsculas, importe como string, fechas y procesamiento por lotes\n// ============================================================\n\nconst items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n  const body = item.json.body ?? item.json;\n  \n  // Soporte para lotes: si el cuerpo es un array de pagos\n  const rawPayments = Array.isArray(body) ? body : [body];\n  \n  for (const raw of rawPayments) {\n    if (!raw || Object.keys(raw).length === 0) continue;\n\n    // ID del pago: trim + uppercase\n    const id_pago = String(raw.id_pago ?? '').trim().toUpperCase();\n    \n    if (!id_pago) {\n      throw new Error('El campo id_pago es obligatorio para todos los registros');\n    }\n\n    // Email: trim + lowercase\n    const email = String(raw.email ?? '').trim().toLowerCase();\n\n    // Nombre: solo trim\n    const nombre = String(raw.nombre ?? '').trim();\n\n    // Curso: solo trim\n    const curso = String(raw.curso ?? '').trim();\n\n    // Importe: puede venir como string \"75000\" → convertir a número limpio\n    const importe = parseFloat(\n      String(raw.importe ?? '0').replace(/[^0-9.]/g, '')\n    ) || 0;\n\n    // Moneda: trim + uppercase\n    const moneda = String(raw.moneda ?? '').trim().toUpperCase();\n\n    // Estado: trim + lowercase\n    const estado = String(raw.estado ?? '').trim().toLowerCase();\n\n    // Fecha: normalizar a ISO 8601 UTC\n    let fecha;\n    try {\n      fecha = raw.fecha ? new Date(raw.fecha).toISOString() : new Date().toISOString();\n    } catch (e) {\n      fecha = new Date().toISOString();\n    }\n\n    result.push({\n      json: { id_pago, email, nombre, curso, importe, moneda, estado, fecha }\n    });\n  }\n}\n\nreturn result;\n"
      },
